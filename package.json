{
  "name": "aria",
  "version": "1.0.1",
  "description": "ARIA - Mukunth's AI Assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "build": {
    "appId": "com.mukunth.aria",
    "productName": "ARIA",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true
    },
    "dmg": {
      "title": "LOGAT",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "main.js",
      "index.html",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.0.0"
  }
}
